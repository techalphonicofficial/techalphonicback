APP_NAME="Tech Alphonic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Absolute URLs (canonicals, sitemaps, schema, media) are built from APP_URL.
# Production: the PUBLIC domain visitors use (e.g. https://www.example.com), not the backend's internal address.
APP_URL=http://techalphonic.test
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

# Admin panel URL prefix — use something non-obvious in production (letters, numbers, hyphens).
ADMIN_PATH=admin
PREVIEW_LINK_HOURS=72
MAX_UPLOAD_KB=8192

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=techalphonic
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=techalphonic_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP — credentials live here only, never in the database.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@techalphonic.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional Google reCAPTCHA v3 (enable in Admin → Settings → Forms)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Optional (used only if you add map features beyond the embed URL)
GOOGLE_MAPS_API_KEY=

VITE_APP_NAME="${APP_NAME}"

# Next.js frontend (frontend/) - see frontend/.env.example
# Public site origin. Public URLs that reach Laravel are 301'd here and admin saves revalidate it.
# Production: same as APP_URL. Required: without it, public URLs on this host return 404.
FRONTEND_URL=http://localhost:3000
FRONTEND_API_KEY=
FRONTEND_REVALIDATE_SECRET=
